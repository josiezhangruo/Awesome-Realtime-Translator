<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms><!-- 只为了 NotifyIcon（托盘图标），WPF 自己没有 -->
    <RootNamespace>AwesomeRealtimeTranslator</RootNamespace>
    <AssemblyName>AwesomeRealtimeTranslator</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- LibraryImport 源生成器产出的封送代码是 unsafe 的，必须打开 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
    <Version>0.1.5</Version>

    <!-- 在非 Windows 机器上也能编译（本项目就是在 macOS 上开发的）。 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      钉死 RID。这是个 Windows 应用，没有「跟随宿主平台」这回事；
      不钉的话在 macOS 上跑 dotnet build 会去找 osx-arm64 的 WindowsDesktop
      运行时包，然后 NETSDK1082 失败。钉上之后整个解决方案在 Mac 上也能一把构建。
      要出 ARM 版 Windows 包就命令行传 -r win-arm64 覆盖。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      自带 .NET 运行时，用户不需要装任何东西。托管程序集打进单个 exe，
      启动时从内存加载，不落盘。

      但原生库（whisper、onnxruntime）必须留在 exe 旁边，不能自解压：
      IncludeNativeLibrariesForSelfExtract=true 会让 exe 每次启动把原生 dll
      解压到 %TEMP%\.net\ 再加载，而「进程把可执行代码写进临时目录然后加载」
      正是杀毒软件启发式规则里的典型 dropper 特征——0.1.0/0.1.1 被拦在
      「正在加载语音识别模型…」就是这么来的。

      而且这个设置本来就没换来任何好处：语音和翻译模型塞不进 exe，
      models/ 必须跟 exe 同目录，所以用户拿到的从头到尾都是一个文件夹。
      纯亏，关掉。
    -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms 会把 System.Windows.Forms 和 System.Drawing 塞进全局 using，
      于是 Application / Clipboard / Color 这些名字同时存在于 WPF 和 WinForms 两边，
      满屏 CS0104。这里只为了托盘图标（NotifyIcon）才引 WinForms，
      所以把这两个全局 using 摘掉，需要的地方用 Forms 别名或全名。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      开给窗口构造测试。要的就是两样东西：SettingsWindow 的构造函数
      （它是私有单例，外面只有 Show()），以及 WPF 为 x:Name 生成的字段
      ——那些字段默认就是 internal，所以断言「标签真的填上了」必须走这条路。
      测试工程的 AssemblyName 必须正好是 App.Tests。
    -->
    <InternalsVisibleTo Include="App.Tests" />
  </ItemGroup>

</Project>
